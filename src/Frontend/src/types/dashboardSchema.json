{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DashboardSpecification",
  "type": "object",
  "additionalProperties": false,
  "required": ["dashboardId", "title", "version", "theme", "refreshRateMs", "gridLayout", "widgets"],
  "properties": {
    "dashboardId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "theme": { "enum": ["DARK", "LIGHT", "SYSTEM"] },
    "refreshRateMs": { "type": "integer", "minimum": 0 },
    "gridLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rowHeight", "items"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "rowHeight": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["widgetId", "x", "y", "w", "h"],
            "properties": {
              "widgetId": { "type": "string", "minLength": 1 },
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "w": { "type": "integer", "minimum": 1 },
              "h": { "type": "integer", "minimum": 1 },
              "minW": { "type": "integer", "minimum": 1 },
              "minH": { "type": "integer", "minimum": 1 },
              "static": { "type": "boolean" }
            }
          }
        }
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "chartType", "semanticModelRef", "queryAst", "visualEncodings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "chartType": { "enum": ["KPI_CARD", "SPARK_LINE", "LINE", "AREA", "BAR", "STACKED_BAR", "SCATTER", "HEATMAP", "CANDLESTICK", "TABLE"] },
          "semanticModelRef": { "type": "string", "minLength": 1 },
          "queryAst": { "$ref": "#/definitions/queryAst" },
          "visualEncodings": { "$ref": "#/definitions/visualEncodings" },
          "styleOverrides": { "$ref": "#/definitions/styleOverrides" }
        },
        "allOf": [
          {
            "if": { "properties": { "chartType": { "const": "CANDLESTICK" } }, "required": ["chartType"] },
            "then": {
              "properties": {
                "visualEncodings": {
                  "properties": {
                    "yAxis": { "minItems": 4, "maxItems": 4 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "queryAst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelName"],
      "properties": {
        "modelName": { "type": "string", "minLength": 1 },
        "measures": { "$ref": "#/definitions/nonEmptyStringArray" },
        "metrics": { "$ref": "#/definitions/nonEmptyStringArray" },
        "dimensions": { "$ref": "#/definitions/nonEmptyStringArray" },
        "timeDimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "granularity"],
            "properties": {
              "dimension": { "type": "string", "minLength": 1 },
              "granularity": { "enum": ["day", "week", "month", "quarter", "year"] },
              "dateRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "operator", "values"],
            "properties": {
              "member": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["equals", "notEquals", "contains", "greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual", "in", "notIn"] },
              "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } }
            }
          }
        },
        "sorts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["member", "direction"],
            "properties": {
              "member": { "type": "string", "minLength": 1 },
              "direction": { "enum": ["asc", "desc"] }
            }
          }
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "visualEncodings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xAxis", "yAxis"],
      "properties": {
        "xAxis": { "type": "string", "minLength": 1 },
        "yAxis": { "$ref": "#/definitions/nonEmptyStringArray" },
        "colorBy": { "type": "string", "minLength": 1 },
        "sizeBy": { "type": "string", "minLength": 1 },
        "tooltipFields": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "styleOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showLegend": { "type": "boolean" },
        "showGridlines": { "type": "boolean" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
